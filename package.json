{
  "name": "talvuno",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run db:migrate:remote && bun run build && wrangler deploy",
    "check": "wrangler types && bun run routes:generate && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vite build && vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ssr": "vite build && vitest run --project ssr",
    "verify": "biome ci . && bun run check && bun run test",
    "cf:types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply talvuno-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply talvuno-db --remote",
    "routes:generate": "bun scripts/routes-generate.mjs",
    "vapid:generate": "bun scripts/vapid-generate.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@hono/zod-validator": "^0.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.56",
    "@twilio/voice-sdk": "^2.18.5",
    "better-auth": "^1.7.6",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "i18next": "^26.4.2",
    "libphonenumber-js": "^1.13.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "^1.167.38",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "5",
    "vite": "^8.3.0",
    "vitest": "4",
    "wrangler": "^4.135.0"
  }
}
