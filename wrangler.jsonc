{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "talvuno",
  // No account_id here: set CLOUDFLARE_ACCOUNT_ID in the environment, or add your own "account_id".
  "main": "./src/server.ts",
  // Pinned to the workerd bundled with @cloudflare/vitest-pool-workers, or the integration tests refuse to start.
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Catch-up and retention jobs (src/worker/cron.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true, "logs": { "invocation_logs": true } },
  "upload_source_maps": true,

  // Client bundle and public files come from Workers Static Assets; pages are server-rendered and /api/* is Hono.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/icons/*",
      "!/brand/*",
      "!/sounds/*",
      "!/favicon.ico",
      "!/apple-touch-icon.png",
      "!/manifest.webmanifest",
      "!/sw.js",
      "!/offline.html"
    ]
  },

  "vars": {
    // The public origin Twilio calls back and Better Auth trusts. Set yours. Local dev overrides it in .dev.vars.
    "PUBLIC_URL": "https://talvuno.example.com",
    "OIDC_BUTTON_LABEL": "Sign in with SSO",
    // The AI Gateway voicemail transcription runs through. Every account has one named "default"; set yours.
    "AI_GATEWAY_ID": "default"
  },

  // Voicemail audio, under voicemail/<ownerId>/<callId>.<ext> (src/worker/lib/voicemail).
  "r2_buckets": [{ "binding": "RECORDINGS", "bucket_name": "talvuno-recordings" }],

  // Voicemail transcription: the recording callback enqueues { voicemailId }, the queue() handler transcribes.
  "queues": {
    "producers": [{ "binding": "TRANSCRIBE", "queue": "talvuno-transcribe" }],
    "consumers": [
      {
        "queue": "talvuno-transcribe",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "talvuno-transcribe-dlq"
      }
    ]
  },

  // Workers AI for Whisper, always called through the AI Gateway named by AI_GATEWAY_ID.
  "ai": { "binding": "AI" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talvuno-db",
      // Set yours (`wrangler d1 create` prints it).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],

  // One OwnerHub per owner (idFromName(ownerId)): live WebSocket fan-out plus atomic SMS and call counters.
  "durable_objects": {
    "bindings": [{ "name": "OWNER_HUB", "class_name": "OwnerHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OwnerHub"] }]
}
